# Copy to backend/.env (or repo-root .env). Never commit real values.

# auto = Firestore when FIREBASE_CREDENTIALS is set, else SQLite. Also: sqlite | firestore | memory
SWARMGUARD_STORAGE=auto
# Shared workspace all five teammates read/write (Firestore: workspaces/{workspace}/...)
SWARMGUARD_WORKSPACE=default
# SQLite fallback location (default: backend/data/swarmguard.db)
# SWARMGUARD_SQLITE_PATH=

# Firestore (server-side only; the browser never sees these)
# FIREBASE_CREDENTIALS=C:/path/to/service-account.json
# FIREBASE_PROJECT_ID=your-project-id

# Google Gemini API (Member 1 - Agent Simulator)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Anthropic Claude API (alternative provider)
# ANTHROPIC_API_KEY=
SWARMGUARD_LLM_MODEL=claude-haiku-5-5

# Run agent-written code locally during user-task runs (off by default; NOT a sandbox)
# SWARMGUARD_ALLOW_CODE_EXEC=1

# Hard cap on model calls per simulation run (spending limit)
SWARMGUARD_LLM_MAX_CALLS=20

SWARMGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
